# ---- Adatbázis (Supabase Postgres) ----
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (6543-as port)
DATABASE_URL=postgresql://postgres.xxxxxxxx:JELSZO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---- Supabase (Auth + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings → API Keys → publishable (régen: anon) kulcs
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → secret / service_role kulcs — SOHA ne kerüljön böngészőbe
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin subdomain (opcionális) ----
# Ha be van állítva, az admin CSAK ezen a címen érhető el, a fő domainen az /admin 404.
# ADMIN_HOST=admin.undercover.hu

# ---- E-mail (Resend) ----
RESEND_API_KEY=
# Hitelesített domainről, pl. "Under Cover <info@undercover.hu>"
RESEND_FROM_EMAIL=
# Ki kapjon értesítést új jelentkezésről (vesszővel több cím is megadható)
APPLICATION_NOTIFY_EMAIL=
# A jelentkező visszaigazoló e-mailt kap-e (csak saját, hitelesített domain után kapcsold be)
APPLICANT_CONFIRMATION_ENABLED=false

# ---- Egyéb ----
# Az oldal végleges címe (megosztási képekhez); Vercelen nélküle is működik
# NEXT_PUBLIC_SITE_URL=https://undercover.hu
# Tetszőleges hosszú, véletlen szöveg az IP-címek álnevesítéséhez (spamvédelem)
IP_HASH_SALT=
